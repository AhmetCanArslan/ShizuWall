<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/mobile_circle_block_hidden_24dp">
  <target android:name="b1">
    <aapt:attr name="android:animation">
      <objectAnimator
          android:propertyName="fillAlpha"
          android:valueFrom="0"
          android:valueTo="1"
          android:valueType="floatType"
          android:startOffset="0"
          android:duration="200"
          android:interpolator="@android:interpolator/fast_out_slow_in"/>
    </aapt:attr>
  </target>
  <target android:name="b2">
    <aapt:attr name="android:animation">
      <objectAnimator
          android:propertyName="fillAlpha"
          android:valueFrom="0"
          android:valueTo="1"
          android:valueType="floatType"
          android:startOffset="170"
          android:duration="200"
          android:interpolator="@android:interpolator/fast_out_slow_in"/>
    </aapt:attr>
  </target>
  <target android:name="b3">
    <aapt:attr name="android:animation">
      <objectAnimator
          android:propertyName="fillAlpha"
          android:valueFrom="0"
          android:valueTo="1"
          android:valueType="floatType"
          android:startOffset="340"
          android:duration="200"
          android:interpolator="@android:interpolator/fast_out_slow_in"/>
    </aapt:attr>
  </target>
</animated-vector>
