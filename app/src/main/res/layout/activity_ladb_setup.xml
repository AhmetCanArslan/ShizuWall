<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ladbSetupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/ladbToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="@string/set_ladb_title"
        app:navigationIcon="@drawable/ic_arrow_back_24" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdvancedMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/advanced_mode"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized"
                            android:textColor="?android:attr/textColorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/advanced_mode_description"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?android:attr/textColorSecondary" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAdvancedMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        app:thumbIcon="@drawable/check_24px"
                        app:thumbIconTint="@color/switch_thumb_icon_tint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Simple Setup View -->
            <LinearLayout
                android:id="@+id/simpleSetupContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ladb_setup_guidance"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="?android:attr/textColorPrimary"
                            android:paddingBottom="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.Material3Expressive.Button"
                                android:id="@+id/btnPairSimple"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/pair"
                                app:backgroundTint="?attr/colorPrimaryContainer"
                                android:textColor="?attr/colorOnPrimaryContainer" />

                            <ProgressBar
                                android:id="@+id/connectProgressSimple"
                                style="?android:attr/progressBarStyleSmall"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="12dp"
                                android:indeterminate="true"
                                android:visibility="gone" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="16dp">

                            <View
                                android:id="@+id/daemonStatusIndicatorSimple"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@android:color/darker_gray"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/tvDaemonStatusSimple"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/daemon_status_stopped"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                android:textColor="?android:attr/textColorSecondary" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Advanced Setup View -->
            <LinearLayout
                android:id="@+id/advancedSetupContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Status Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/tvLadbStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ladb_status_unconfigured"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="?android:attr/textColorSecondary"
                        android:padding="16dp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Auto Pairing Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ladb_auto_pairing_title"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized"
                        android:textColor="?android:attr/textColorPrimary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ladb_auto_pairing_description"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?android:attr/textColorSecondary"
                        android:paddingTop="4dp"
                        android:paddingBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Material3Expressive.Button"
                        android:id="@+id/btnPair"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pair"
                        app:backgroundTint="?attr/colorPrimaryContainer"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.Material3Expressive.Button"
                            android:id="@+id/btnConnect"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ladb_connect"
                            app:backgroundTint="?attr/colorPrimaryContainer"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <ProgressBar
                            android:id="@+id/connectProgress"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="12dp"
                            android:indeterminate="true"
                            android:visibility="gone" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Material3Expressive.Button"
                        android:id="@+id/btnUnpair"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ladb_unpair"
                        android:layout_marginTop="8dp"
                        android:enabled="false"
                        app:backgroundTint="?attr/colorPrimaryContainer"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

                <!-- Manual Connection Card (custom host/port) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ladb_manual_connection_title"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized"
                        android:textColor="?android:attr/textColorPrimary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ladb_manual_connection_description"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?android:attr/textColorSecondary"
                        android:paddingTop="4dp"
                        android:paddingBottom="12dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilManualHost"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/manual_host_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etManualHost"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textNoSuggestions"
                            android:text="127.0.0.1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilManualPort"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/manual_port_hint"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etManualPort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="5" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.Material3Expressive.Button.OutlinedButton"
                            android:id="@+id/btnCheckAndConnect"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/btn_check_and_connect" />

                        <ProgressBar
                            android:id="@+id/checkConnectProgress"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="12dp"
                            android:indeterminate="true"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvManualConnectStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Daemon Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="12dp">

                        <View
                            android:id="@+id/daemonStatusIndicator"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@android:color/darker_gray"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/tvDaemonStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/daemon_status_stopped"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="?android:attr/textColorSecondary" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDaemonCommands"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Quick Commands"
                        android:layout_marginBottom="8dp">

                        <AutoCompleteTextView
                            android:id="@+id/actvDaemonCommands"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Material3Expressive.Button"
                        android:id="@+id/btnStartDaemon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/daemon_start"
                        android:layout_marginTop="12dp"
                        app:backgroundTint="?attr/colorPrimaryContainer"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Material3Expressive.Button"
                        android:id="@+id/btnKillDaemon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/daemon_kill"
                        android:layout_marginTop="8dp"
                        app:backgroundTint="?attr/colorErrorContainer"
                        android:textColor="?attr/colorOnErrorContainer" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- LADB Logs Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ladb_logs_title"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized"
                        android:textColor="?android:attr/textColorPrimary"
                        android:paddingBottom="8dp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchEnableLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ladb_enable_logs"
                        android:checked="false"
                        android:layout_marginBottom="8dp"
                        app:thumbIcon="@drawable/check_24px"
                        app:thumbIconTint="@color/switch_thumb_icon_tint" />

                    <LinearLayout
                        android:id="@+id/logsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <androidx.core.widget.NestedScrollView
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:background="?attr/colorSurfaceVariant"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/tvLadbLogs"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ladb_logs_empty"
                                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                android:textColor="?android:attr/textColorSecondary"
                                android:fontFamily="monospace"
                                android:typeface="monospace" />
                        </androidx.core.widget.NestedScrollView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.Material3Expressive.Button.OutlinedButton"
                                android:id="@+id/btnClearLogs"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/ladb_clear_logs"
                                android:layout_marginEnd="8dp"
                               />

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.Material3Expressive.Button.OutlinedButton"
                                android:id="@+id/btnCopyLogs"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/ladb_copy_logs"
                                android:layout_marginStart="8dp"
                               />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Direct ADB start (visible in both simple and advanced mode) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdbDirectStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_picon_usb"
                            android:contentDescription="@null"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ladb_adb_method_title"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized"
                            android:textColor="?android:attr/textColorPrimary" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ladb_adb_method_description"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:lineSpacingExtra="3dp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ladb_adb_command_label"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium.Emphasized"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="?attr/colorSurfaceVariant"
                        app:strokeWidth="0dp">

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tvAdbCommand"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textIsSelectable="true"
                                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                android:lineSpacingExtra="2dp"
                                android:fontFamily="monospace"
                                android:typeface="monospace"
                                android:textColor="?android:attr/textColorPrimary"
                                android:text="@string/ladb_adb_command_preparing" />
                        </HorizontalScrollView>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.Material3Expressive.Button"
                            android:id="@+id/btnCopyAdbCommand"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ladb_copy_command"
                            app:icon="@drawable/content_copy_24px"
                            app:backgroundTint="?attr/colorPrimaryContainer"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            app:iconTint="?attr/colorOnPrimaryContainer" />

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.Material3Expressive.Button.OutlinedButton"
                            android:id="@+id/btnShareAdbCommand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/ladb_share_command" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="14dp"
                        android:background="?attr/colorOutlineVariant" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ladb_adb_method_steps"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:lineSpacingExtra="4dp"
                        android:textColor="?android:attr/textColorSecondary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

