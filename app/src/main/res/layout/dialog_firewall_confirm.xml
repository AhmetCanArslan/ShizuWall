<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/dialog_background">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enable_firewall_dialog_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge.Emphasized"
        android:layout_marginBottom="16dp"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enable_firewall_dialog_message"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:layout_marginBottom="16dp"
        android:textColor="?attr/colorOnSurface" /> 

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/selected_apps_label"
        android:textAppearance="@style/TextAppearance.Material3.TitleSmall.Emphasized"
        android:layout_marginBottom="8dp"
        android:textColor="?attr/colorOnSurface" /> 

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/selectedAppsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="200dp"
        android:layout_marginBottom="16dp" />


</LinearLayout>
