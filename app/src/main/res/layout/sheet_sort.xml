<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sheet_rounded_top_bg"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/sheet_drag_handle_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sortTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sort"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall.Emphasized"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/textFilteringNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/app_filtering_note"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <RadioGroup
            android:id="@+id/radioGroupSort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp">

            <com.google.android.material.radiobutton.MaterialRadioButton
                style="@style/Widget.Material3.CompoundButton.RadioButton"
                android:id="@+id/radioInstallTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sort_install_time"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                style="@style/Widget.Material3.CompoundButton.RadioButton"
                android:id="@+id/radioNameAsc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sort_name_asc"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                style="@style/Widget.Material3.CompoundButton.RadioButton"
                android:id="@+id/radioNameDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sort_name_desc"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
        </RadioGroup>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="8dp"
            app:dividerColor="?attr/colorOutlineVariant" />

        <com.google.android.material.checkbox.MaterialCheckBox
            style="@style/Widget.Material3.CompoundButton.CheckBox"
            android:id="@+id/checkboxShowSystemApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:minHeight="48dp"
            android:text="@string/show_system_apps"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <com.google.android.material.checkbox.MaterialCheckBox
            style="@style/Widget.Material3.CompoundButton.CheckBox"
            android:id="@+id/checkboxShowOtherProfiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:minHeight="48dp"
            android:text="@string/show_other_profiles"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <TextView
            android:id="@+id/textOtherProfilesNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="20dp"
            android:text="@string/show_other_profiles_description"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sortCancelButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:paddingVertical="14dp"
            android:text="@string/cancel"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sortApplyButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="14dp"
            android:text="@string/apply"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            app:cornerRadius="18dp"
            app:icon="@drawable/check_24px"
            app:iconGravity="textStart" />
    </LinearLayout>

</LinearLayout>
